{
  "name": "rakovarnya-73",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prepare-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:cloudflare": "tsc -b && vite build --base=/ && node scripts/prepare-seo.mjs",
    "check:cloudflare-functions": "npx --yes wrangler@4 pages functions build functions --outdir=/tmp/raki-pages-functions",
    "check:vercel-function": "tsc --noEmit --target ES2022 --lib ES2022,DOM --strict --skipLibCheck --moduleResolution bundler --module ESNext api/order.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "gsap": "3.14.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.6"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3"
  }
}
